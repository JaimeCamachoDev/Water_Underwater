# ===============================================================
# .gitattributes para proyectos Unity (Windows, GitHub, multiplataforma)
# JaimeCamachoDev - Previene errores de saltos de línea y conflictos CRLF/LF
# ===============================================================

# Normalizar todos los archivos de texto a LF (estándar GitHub)
* text=auto eol=lf

# Código y archivos de texto
*.cs           text eol=lf diff=csharp
*.shader       text eol=lf
*.cginc        text eol=lf
*.hlsl         text eol=lf
*.compute      text eol=lf
*.uxml         text eol=lf
*.uss          text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.txt          text eol=lf
*.md           text eol=lf
*.meta         text eol=lf

# Archivos YAML de Unity (texto con Force Text; merge con UnityYAMLMerge si está configurado)
ProjectSettings/**      text eol=lf
*.unity                 merge=unityyamlmerge
*.prefab                merge=unityyamlmerge
*.asset                 merge=unityyamlmerge
*.mat                   merge=unityyamlmerge
*.anim                  merge=unityyamlmerge
*.controller            merge=unityyamlmerge
*.overrideController    merge=unityyamlmerge
*.physicMaterial        merge=unityyamlmerge
*.physicsMaterial2D     merge=unityyamlmerge
*.playable              merge=unityyamlmerge
*.mask                  merge=unityyamlmerge
*.lighting              merge=unityyamlmerge
*.preset                merge=unityyamlmerge
*.spriteatlas           merge=unityyamlmerge
*.terrainlayer          merge=unityyamlmerge

# Archivos binarios (sin conversión de texto ni diff)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.psd          binary
*.tga          binary
*.tif          binary
*.tiff         binary
*.exr          binary
*.hdr          binary
*.cubemap      binary
*.fbx          binary
*.obj          binary
*.blend        binary
*.abc          binary
*.mp3          binary
*.ogg          binary
*.wav          binary
*.mp4          binary
*.mov          binary
*.webm         binary
*.ttf          binary
*.otf          binary
*.dll          binary
*.so           binary
*.exe          binary
*.apk          binary
*.zip          binary
*.rar          binary
*.7z           binary
*.unitypackage binary
*.pdf          binary

# Archivos .lock con merge más flexible
*.lock merge=union
