// Falling water sheet for VR (Quest / Pico), companion of "SevenWonders/Water/Canal Flow".
// Built for meshes generated by WaterCascade (works on any ribbon with the same UV layout):
//   uv0 = (across in metres, distance along the flow in metres)
//   uv1 = (across 0..1, aeration 0..1: 0 on the lip, 1 at the impact)
//   uv2 = (arrival time in seconds of the water at this vertex, 0)
// Scrolling with the arrival time makes the pattern travel at the real (accelerating) speed and stretch
// as it falls. Single transparent pass, two-sided, no opaque texture. Scene depth softens the contact.
Shader "SevenWonders/Water/Cascade Flow"
{
    Properties
    {
        [Header(Color)]
        _WaterColor ("Water Color", Color) = (0.30, 0.60, 0.55, 1)
        _DeepColor ("Thick Water Color", Color) = (0.06, 0.24, 0.27, 1)
        _SheetOpacity ("Sheet Opacity", Range(0, 1)) = 0.35
        _EdgeOpacity ("Grazing Opacity", Range(0, 1)) = 0.75

        [Header(Flow)]
        [NoScaleOffset][Normal] _NormalMap ("Normal Map", 2D) = "bump" {}
        _NormalTiling ("Normal Tiling Across (repeats per m)", Float) = 3
        _TimeTiling ("Normal Tiling Along (repeats per second of travel)", Float) = 2.2
        _Acceleration ("Acceleration Stretch", Range(0, 1)) = 0.7
        _RefSpeed ("Reference Speed (m/s)", Float) = 1.2
        _NormalStrength ("Normal Strength", Range(0, 2)) = 0.9
        _DetailTiling ("Detail Tiling Multiplier", Float) = 2.3

        [Header(Surface)]
        _Smoothness ("Smoothness", Range(0, 1)) = 0.92
        _ReflectionStrength ("Reflection Strength", Range(0, 2)) = 1
        _SpecularStrength ("Sun Specular", Range(0, 4)) = 1.2
        _Translucency ("Sun Translucency", Range(0, 3)) = 1.0

        [Header(Aeration and foam)]
        [NoScaleOffset] _FoamMap ("Foam Mask (alpha)", 2D) = "white" {}
        _FoamColor ("Foam Color", Color) = (0.93, 0.96, 0.95, 1)
        _FoamTiling ("Foam Tiling Across (repeats per m)", Float) = 2.5
        _FoamTimeTiling ("Foam Tiling Along (repeats per second)", Float) = 1.3
        _AerationStart ("Aeration Start", Range(0, 1)) = 0.15
        _AerationEnd ("Aeration Full", Range(0, 1)) = 0.9
        _AerationMax ("Aeration Max", Range(0, 1)) = 0.85
        _Streaks ("White Streaks", Range(0, 1)) = 0.45
        _LipFoam ("Lip Foam", Range(0, 1)) = 0.2

        [Header(Edges and contact)]
        _EdgeSoftness ("Edge Softness (0-1 of half width)", Range(0.01, 1)) = 0.35
        _EdgeBreakup ("Edge Breakup", Range(0, 1)) = 0.5
        _StartFade ("Start Fade (m)", Range(0.001, 0.5)) = 0.05
        [Toggle(_SCENE_DEPTH)] _UseSceneDepth ("Soft Contact (Scene Depth)", Float) = 1
        _ContactFade ("Contact Fade (m)", Range(0.001, 0.3)) = 0.04
        _ContactFoam ("Contact Foam (m)", Range(0, 0.3)) = 0.08

        [Header(Wobble)]
        _WobbleAmplitude ("Wobble Amplitude (m)", Range(0, 0.05)) = 0.008
        _WobbleFrequency ("Wobble Frequency", Float) = 3

        [Header(Flow front driven by script)]
        _FrontTime ("Front Time (s, water visible where arrival < front)", Float) = 100000
        _TailTime ("Tail Time (s, water visible where arrival > tail)", Float) = -100000
        _FrontFoam ("Front Foam Length (s)", Range(0.01, 1)) = 0.12
        _ThinTime ("Thinning Before Cut (s)", Range(0.01, 4)) = 1.2
    }

    SubShader
    {
        Tags
        {
            "RenderPipeline" = "UniversalPipeline"
            "RenderType" = "Transparent"
            "Queue" = "Transparent+1"
            "IgnoreProjector" = "True"
        }

        Pass
        {
            Name "CascadeWater"
            Tags { "LightMode" = "UniversalForward" }

            Blend One OneMinusSrcAlpha // premultiplied
            ZWrite Off
            ZTest LEqual
            Cull Off

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex Vert
            #pragma fragment Frag

            #pragma shader_feature_local _SCENE_DEPTH

            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE
            #pragma multi_compile_fragment _ _SHADOWS_SOFT
            #pragma multi_compile_fog
            #pragma multi_compile_instancing

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareDepthTexture.hlsl"

            TEXTURE2D(_NormalMap); SAMPLER(sampler_NormalMap);
            TEXTURE2D(_FoamMap);   SAMPLER(sampler_FoamMap);

            CBUFFER_START(UnityPerMaterial)
                half4 _WaterColor;
                half4 _DeepColor;
                half _SheetOpacity;
                half _EdgeOpacity;
                float _NormalTiling;
                float _TimeTiling;
                float _Acceleration;
                float _RefSpeed;
                half _NormalStrength;
                float _DetailTiling;
                half _Smoothness;
                half _ReflectionStrength;
                half _SpecularStrength;
                half _Translucency;
                half4 _FoamColor;
                float _FoamTiling;
                float _FoamTimeTiling;
                half _AerationStart;
                half _AerationEnd;
                half _AerationMax;
                half _Streaks;
                half _LipFoam;
                half _EdgeSoftness;
                half _EdgeBreakup;
                float _StartFade;
                half _ContactFade;
                half _ContactFoam;
                float _WobbleAmplitude;
                float _WobbleFrequency;
                float _FrontTime;
                float _TailTime;
                half _FrontFoam;
                float _ThinTime;
            CBUFFER_END

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float4 tangentOS  : TANGENT;
                float2 uv0        : TEXCOORD0;
                float2 uv1        : TEXCOORD1;
                float2 uv2        : TEXCOORD2;
                float2 uv3        : TEXCOORD3; // x = start time of this element (fountain), 0 otherwise
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 positionWS : TEXCOORD0;
                float4 screenPos  : TEXCOORD1;
                half3 normalWS    : TEXCOORD2;
                half4 tangentWS   : TEXCOORD3;
                float4 flow       : TEXCOORD4; // x = across m, y = flow coordinate (s), z = across 0..1, w = aeration
                float4 extra      : TEXCOORD5; // x = distance m, y = fog, z = 1 on the impact disc, w = arrival time
                float elemStart   : TEXCOORD6;
                UNITY_VERTEX_INPUT_INSTANCE_ID
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings Vert(Attributes input)
            {
                Varyings o = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, o);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);

                float arrival = input.uv2.x;
                float aeration = input.uv1.y;
                // flow coordinate: blend of constant speed (distance) and real accelerating speed (arrival time)
                float flowCoord = lerp(input.uv0.y / max(_RefSpeed, 0.01), arrival, _Acceleration);

                // living sheet: small travelling ripple along the normal, stronger while falling
                float edge = 1.0 - abs(input.uv1.x * 2.0 - 1.0);
                float wobble = sin((flowCoord - _Time.y) * _WobbleFrequency * 6.2832 + input.uv0.x * 9.0)
                             + 0.5 * sin((flowCoord - _Time.y * 1.3) * _WobbleFrequency * 11.0 - input.uv0.x * 17.0);
                float3 posOS = input.positionOS.xyz + input.normalOS * wobble * _WobbleAmplitude * saturate(aeration * 3.0) * (0.4 + 0.6 * edge);

                VertexPositionInputs vpi = GetVertexPositionInputs(posOS);
                VertexNormalInputs vni = GetVertexNormalInputs(input.normalOS, input.tangentOS);
                o.positionCS = vpi.positionCS;
                o.positionWS = vpi.positionWS;
                o.screenPos = ComputeScreenPos(vpi.positionCS);
                o.normalWS = vni.normalWS;
                o.tangentWS = half4(vni.tangentWS, input.tangentOS.w * GetOddNegativeScale());
                o.flow = float4(input.uv0.x, flowCoord, input.uv1.x, aeration);
                o.extra = float4(input.uv0.y, ComputeFogFactor(vpi.positionCS.z), input.uv2.y, arrival);
                o.elemStart = input.uv3.x;
                return o;
            }

            half4 Frag(Varyings input, FRONT_FACE_TYPE face : FRONT_FACE_SEMANTIC) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(input);

                float t = _Time.y;
                float acrossM = input.flow.x;
                float flowCoord = input.flow.y;
                float across01 = input.flow.z;
                half aeration = saturate(input.flow.w);
                float dist = input.extra.x;

                // --- Water front / tail (turning the flow on and off travels at the real speed)
                float arrivalT = input.extra.w;
                float frontDist = _FrontTime - arrivalT;
                // turning off: each element first thins into rivulets for _ThinTime, then the last water falls away
                clip(min(frontDist, arrivalT - (_TailTime - _ThinTime)));
                half thin = saturate((_TailTime - input.elemStart) / _ThinTime);
                half frontFoam = 1.0 - saturate(frontDist / _FrontFoam);

                // --- Normals (tangent = across, bitangent = downstream)
                float2 uvN = float2(acrossM * _NormalTiling, (flowCoord - t) * _TimeTiling);
                half3 n1 = UnpackNormalScale(SAMPLE_TEXTURE2D(_NormalMap, sampler_NormalMap, uvN), _NormalStrength);
                half3 n2 = UnpackNormalScale(SAMPLE_TEXTURE2D(_NormalMap, sampler_NormalMap,
                    uvN * float2(_DetailTiling, _DetailTiling * 0.7) + float2(0.31, 0.57)), _NormalStrength * 0.6);
                half3 nTS = normalize(half3(n1.xy + n2.xy, n1.z * n2.z));

                half3 geoN = normalize(input.normalWS);
                half3 tanW = normalize(input.tangentWS.xyz);
                half3 bitW = cross(geoN, tanW) * input.tangentWS.w;
                half3 N = normalize(tanW * nTS.x + bitW * nTS.y + geoN * nTS.z);
                bool front = IS_FRONT_VFACE(face, true, false);
                N = front ? N : -N;

                float3 viewVec = GetWorldSpaceViewDir(input.positionWS);
                half3 V = normalize(viewVec);
                half NdotV = saturate(dot(N, V));

                // --- Aeration / foam: stretched streaks that turn white while falling
                float2 uvF = float2(acrossM * _FoamTiling, (flowCoord - t) * _FoamTimeTiling) + nTS.xy * 0.04;
                half foamA = SAMPLE_TEXTURE2D(_FoamMap, sampler_FoamMap, uvF).a;
                half foamB = SAMPLE_TEXTURE2D(_FoamMap, sampler_FoamMap, uvF * float2(3.0, 0.45) + float2(0.43, 0.17)).a;
                half aer = smoothstep(_AerationStart, _AerationEnd, aeration) * _AerationMax;
                aer = max(aer, _LipFoam * (1.0 - saturate(dist / 0.25)));
                aer = max(aer, frontFoam * _AerationMax);

                // --- Contact with the receiving surface (scene depth)
                float2 screenUV = input.screenPos.xy / input.screenPos.w;
                half contactFade = 1;
            #if defined(_SCENE_DEPTH)
                float sceneEye = LinearEyeDepth(SampleSceneDepth(screenUV), _ZBufferParams);
                float gap = sceneEye - input.screenPos.w;
                contactFade = lerp(saturate(gap / _ContactFade), 1.0, input.extra.z); // disc lies on the surface
                aer = max(aer, (1.0 - saturate(gap / max(_ContactFoam, 1e-4))) * _AerationMax * (1.0 - input.extra.z));
            #endif

                half foam = saturate((foamA - (1.0 - aer)) * 2.5);
                half streak = saturate((foamB - 0.55) * 4.0) * _Streaks * saturate(aeration * 4.0);
                foam = saturate(max(foam, streak));

                // --- Edges: thin, ragged sides
                half edgeDist = 1.0 - abs(across01 * 2.0 - 1.0);
                half edgeMask = saturate((edgeDist - (foamA - 0.5) * _EdgeBreakup * 0.6) / _EdgeSoftness);
                half startMask = saturate(dist / _StartFade);
                half rivulets = saturate((foamA * 0.8 + foamB * 0.5 + 0.35 - thin * 1.6) * 5.0);
                edgeMask *= lerp(1.0, rivulets, saturate(thin * 3.0));

                // --- Lighting
                Light mainLight = GetMainLight(TransformWorldToShadowCoord(input.positionWS));
                half3 sun = mainLight.color * (mainLight.shadowAttenuation * mainLight.distanceAttenuation);
                half3 L = mainLight.direction;
                half3 ambient = SampleSH(N);

                half thick = saturate(edgeMask * (1.0 - NdotV * 0.5));
                half3 waterCol = lerp(_WaterColor.rgb, _DeepColor.rgb, thick * 0.6);
                half wrap = saturate(dot(N, L) * 0.5 + 0.5);
                // sun shining through the sheet towards the viewer
                half back = pow(saturate(dot(V, -L + N * 0.3)), 4.0) * _Translucency;
                half3 bodyLit = waterCol * (ambient + sun * (wrap * 0.5 + back));
                half3 foamLit = _FoamColor.rgb * (ambient + sun * (wrap * 0.8 + back * 0.5 + 0.1));

                half alpha = lerp(_SheetOpacity, _EdgeOpacity, pow(1.0 - NdotV, 2.0));
                half3 surfaceCol = lerp(bodyLit, foamLit, foam);
                alpha = lerp(alpha, 1.0, foam);

                half smooth = _Smoothness * (1.0 - foam * 0.8);
                half fresnel = (0.02 + 0.98 * pow(1.0 - NdotV, 5.0)) * (1.0 - foam);
                half3 env = GlossyEnvironmentReflection(reflect(-V, N), 1.0 - smooth, 1.0) * _ReflectionStrength;
                half3 H = normalize(L + V);
                half specPow = exp2(10.0 * smooth + 1.0);
                half spec = pow(saturate(dot(N, H)), specPow) * (specPow + 8.0) * (1.0 / 25.13) * _SpecularStrength * 0.16;

                half outA = lerp(alpha, 1.0, fresnel);
                half3 rgb = surfaceCol * alpha * (1.0 - fresnel) + env * fresnel + sun * spec;

                half mask = edgeMask * startMask * contactFade;
                rgb *= mask;
                outA *= mask;

                rgb = MixFogColor(rgb, unity_FogColor.rgb * outA, input.extra.y);
                return half4(rgb, outA);
            }
            ENDHLSL
        }
    }
    FallBack Off
}
